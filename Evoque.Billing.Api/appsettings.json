{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "BillingDatabase": ""
  },
  "Asaas": {
    "IntegrationEnvironment": "Sandbox",
    "BaseUrl": "https://api-sandbox.asaas.com/v3/",
    "AllowChargeCreation": false,
    "AllowInvoiceIssuance": false
  },
  "FiscalInvoice": {
    "MunicipalServiceId": "82367",
    "IssTaxRate": 5.00,
    "ServiceDescriptionTemplate": "Serviços prestados em {competencia}.",
    "MunicipalServiceNameTemplate": "Serviços prestados em {competencia}"
  },
  "Evo": {
    "BaseUrl": "https://evo-integracao-api.w12app.com.br/"
  },
  "CompanyRegistry": {
    "BaseUrl": "https://brasilapi.com.br/api/",
    "TimeoutSeconds": 8,
    "MaximumConcurrentLookups": 3
  }
}
