COMPOSE_PROJECT_NAME=evoque
EVOQUE_HTTP_PORT=8085
PUBLIC_APPLICATION_URL=https://faturamento.seu-dominio.com.br

# As imagens :main são atualizadas pelos workflows. Use um SHA somente para
# diagnóstico ou rollback controlado.
EVOQUE_API_IMAGE_TAG=main
EVOQUE_WEB_IMAGE_TAG=main

MYSQL_PASSWORD=gere-uma-senha-forte-no-github-secret

# O MVP na VPS usa exclusivamente o Asaas Sandbox.
ASAAS__INTEGRATIONENVIRONMENT=Sandbox
ASAAS__BASEURL=https://api-sandbox.asaas.com/v3/
ASAAS__APIKEY=troque-por-uma-chave-sandbox-secreta
ASAAS__ALLOWCHARGECREATION=true

EVO__BASEURL=https://evo-integracao-api.w12app.com.br
EVO__USERNAME=troque-pelo-usuario-evo
EVO__APIKEY=troque-pelo-token-evo
