COMPOSE_PROJECT_NAME=evoque
EVOQUE_HTTP_PORT=8088

# As imagens :main são atualizadas pelos workflows. Use um SHA somente para
# diagnóstico ou rollback controlado.
EVOQUE_API_IMAGE_TAG=main
EVOQUE_WEB_IMAGE_TAG=main

MYSQL_PASSWORD=gere-uma-senha-forte-no-github-secret

# O Compose fixa o MVP no Asaas Sandbox. Somente a credencial fica fora do Git.
ASAAS__APIKEY=troque-por-uma-chave-sandbox-secreta
# A criação de cobranças reais só é habilitada pelo workflow quando a variável
# protegida ASAAS_PRODUCTION_CHARGE_CREATION_ENABLED estiver como true.
ASAAS__PRODUCTION__APIKEY=troque-por-uma-chave-producao-secreta
ASAAS__PRODUCTION__ALLOWCHARGECREATION=false

EVO__USERNAME=troque-pelo-usuario-evo
EVO__APIKEY=troque-pelo-token-evo

# Operadores do portal. Sem ao menos um, a API se recusa a subir — uma lista
# vazia seria indistinguível de "sem restrição".
# As senhas são geradas, nunca escolhidas: ninguém reusa dezesseis caracteres
# aleatórios, e é o reuso que faria um vazamento atingir outros sistemas.
AUTH__USERS__0__USERNAME=troque-pelo-usuario
AUTH__USERS__0__PASSWORD=troque-por-uma-senha-gerada
